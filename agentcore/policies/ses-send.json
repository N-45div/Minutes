{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmailTheParentADecisionNotice",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:*:*:identity/*"
    },
    {
      "Sid": "AskSesToConfirmTheParentsAddress",
      "Effect": "Allow",
      "Action": ["ses:CreateEmailIdentity", "ses:GetEmailIdentity"],
      "Resource": "arn:aws:ses:*:*:identity/*"
    }
  ]
}
